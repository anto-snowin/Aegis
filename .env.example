# Aegis Flow - Environment Variables
# Copy this file to .env and fill in the values

# Backend
SECRET_KEY=change-this-to-a-random-secret-key
DATABASE_URL=sqlite:///./aegis_flow.db
HOST=0.0.0.0
PORT=8000
DEBUG=true

# MQTT Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# AI Settings
AI_ENABLED=true
SIMULATION_MODE=true
CAMERA_ENABLED=false

# Signal Control
SIGNAL_HARDWARE_MODE=false
ALL_RED_CLEARANCE_MS=2000
COMMAND_EXPIRY_SECONDS=60
GPS_STALE_THRESHOLD_SECONDS=10
